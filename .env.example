# Kopieren nach .env und Werte eintragen. Die .env wird nie committet.

# PostgreSQL (lokal unter Windows, siehe docs/postgres-windows.md)
DATABASE_URL=postgres://echte_balance:PASSWORT@localhost:5432/echte_balance

# 32 Byte, Base64. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Verschlüsselt die Meta-Tokens der Kunden. Geht der Schlüssel verloren,
# müssen alle Kunden ihren Token neu eingeben. Nie ändern ohne Migration.
TOKEN_ENCRYPTION_KEY=

# Telegram-Bot für Kunden (eigener Bot, NICHT der Jarvis-Token)
CUSTOMER_BOT_TOKEN=
# Deine Telegram-User-ID, für Admin-Befehle (Einladungen erzeugen usw.)
ADMIN_TELEGRAM_ID=

# Optional: anderer Spendenlink für /unterstuetzen (Standard: https://paypal.me/counting)
DONATION_URL=
# Öffentlicher Link zur Anleitung (docs/anleitung.html). Leer = Bot schickt die Datei.
GUIDE_URL=

# Raspberry Pi für npm run deploy:pi (nur auf dem PC nötig)
PI_SSH=
# Optional, Standard: ~/.ssh/echte_balance_pi
PI_KEY=
